rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Services - public read (booking form dropdown); only James (authenticated) can manage
    // the catalog.
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Leads - dashboard only. The public booking form never writes here directly — it goes
    // through POST /api/onNewBooking, which uses the Admin SDK (bypasses these rules).
    match /leads/{leadId} {
      allow read, write: if isAuthenticated();
    }

    // Bookings - dashboard only, same reasoning. Creation, contract generation, and status
    // transitions are all owned by the Vercel API routes (Admin SDK).
    match /bookings/{bookingId} {
      allow read, write: if isAuthenticated();
    }

    // Clients - dashboard only. Created/updated server-side by /api/onNewBooking.
    match /clients/{clientId} {
      allow read, write: if isAuthenticated();
    }

    // Payments - dashboard only
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }

    // Settings - public read (booking form needs the Cal.com link; API routes read payment
    // details); only James (authenticated) can edit them.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
