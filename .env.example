# --- Frontend (Vite, exposed to the browser) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# --- Vercel API routes (server-side only, never prefixed VITE_) ---
# Firebase Admin SDK service account — Firebase Console > Project Settings >
# Service Accounts > Generate new private key. Paste the private_key field as-is
# (with \n line breaks); api/_lib/firebaseAdmin.js un-escapes it at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=

RESEND_API_KEY=
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=
DOCUSEAL_WEBHOOK_SECRET=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
